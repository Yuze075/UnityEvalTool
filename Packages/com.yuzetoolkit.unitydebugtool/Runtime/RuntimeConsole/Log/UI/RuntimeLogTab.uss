.yuzu-runtime-console .yuzu-runtime-log-toolbar-button {
    min-width: 0;
    height: 28px;
    margin: 0 4px 0 0;
    padding: 3px 10px;
    flex-grow: 0;
    flex-shrink: 1;
    overflow: hidden;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    color: rgb(207, 211, 214);
    font-size: 13px;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.yuzu-runtime-console .yuzu-runtime-log-toolbar-button:hover { background-color: rgba(255, 255, 255, 0.08); color: rgb(249, 250, 251); }
.yuzu-runtime-console .yuzu-runtime-log-toolbar-button:focus,
.yuzu-runtime-console .yuzu-runtime-log-toolbar-button:active { background-color: rgba(255, 255, 255, 0.14); border-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-log-toolbar-button:disabled { opacity: 0.4; background-image: none; }
.yuzu-runtime-console .yuzu-runtime-log-clear-button { min-width: 42px; }
.yuzu-runtime-console .yuzu-runtime-log-collapse-toggle { margin-left: 0; }
.yuzu-runtime-console .yuzu-runtime-log-filter-toggle { min-width: 78px; flex-shrink: 0; background-color: transparent; border-color: rgb(84, 85, 87); color: rgb(129, 133, 140); }
.yuzu-runtime-console .yuzu-runtime-log-filter-toggle-active { background-color: rgba(96, 165, 250, 0.20); border-color: rgb(96, 165, 250); color: rgb(249, 250, 251); }
.yuzu-runtime-console .yuzu-runtime-log-filter-indicator { width: 7px; min-width: 7px; height: 7px; min-height: 7px; margin-right: 6px; background-color: rgb(84, 85, 87); border-radius: 4px; }
.yuzu-runtime-console .yuzu-runtime-log-filter-toggle-active .yuzu-runtime-log-filter-indicator { background-color: rgb(207, 211, 214); }
.yuzu-runtime-console .yuzu-runtime-log-filter-warning.yuzu-runtime-log-filter-toggle-active .yuzu-runtime-log-filter-indicator { background-color: rgb(221, 134, 41); }
.yuzu-runtime-console .yuzu-runtime-log-filter-error.yuzu-runtime-log-filter-toggle-active .yuzu-runtime-log-filter-indicator { background-color: rgb(242, 90, 90); }
.yuzu-runtime-console .yuzu-runtime-log-filter-log.yuzu-runtime-log-filter-toggle-active,
.yuzu-runtime-console .yuzu-runtime-log-filter-warning.yuzu-runtime-log-filter-toggle-active,
.yuzu-runtime-console .yuzu-runtime-log-filter-error.yuzu-runtime-log-filter-toggle-active { background-color: rgba(96, 165, 250, 0.20); border-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-log-toolbar-spacer { flex-grow: 1; min-width: 0; }

.yuzu-runtime-console .yuzu-runtime-log-search { position: relative; width: 180px; max-width: 260px; min-width: 88px; min-height: 32px; margin: 0 14px 0 6px; flex-grow: 1; flex-shrink: 1; padding: 0; }
.yuzu-runtime-console .yuzu-runtime-log-search .unity-base-field__label { display: none; }
.yuzu-runtime-console .yuzu-runtime-log-search .unity-base-text-field__input {
    min-width: 0;
    min-height: 32px;
    padding: 4px 8px 4px 28px;
    background-image: none;
    background-color: rgb(35, 35, 36);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: rgb(249, 250, 251);
    font-size: 14px;
    --unity-cursor-color: rgb(249, 250, 251);
    --unity-selection-color: rgba(96, 165, 250, 0.34);
}
.yuzu-runtime-console .yuzu-runtime-log-search .unity-base-text-field__input:hover { background-color: rgb(44, 44, 46); border-color: rgba(255, 255, 255, 0.16); }
.yuzu-runtime-console .yuzu-runtime-log-search .unity-base-text-field__input:focus { border-color: rgb(96, 165, 250); }

.yuzu-runtime-console .yuzu-runtime-log-list,
.yuzu-runtime-console .yuzu-runtime-log-detail { background-color: rgb(21, 21, 23); }
.yuzu-runtime-console .yuzu-runtime-log-row { min-height: 32px; padding: 5px 9px; flex-direction: row; align-items: flex-start; border-left-width: 3px; border-left-color: rgb(129, 133, 140); border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.yuzu-runtime-console .yuzu-runtime-log-row:hover { background-color: rgba(255, 255, 255, 0.08); }
.yuzu-runtime-console .yuzu-runtime-log-row-message { flex-grow: 1; min-width: 0; min-height: 22px; color: rgb(207, 211, 214); font-size: 14px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.yuzu-runtime-console .yuzu-runtime-log-row-log.yuzu-runtime-log-row-selected { background-color: rgba(96, 165, 250, 0.18); border-left-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-log-row-warning { border-left-color: rgb(221, 134, 41); }
.yuzu-runtime-console .yuzu-runtime-log-row-warning .yuzu-runtime-log-row-message { color: rgb(221, 134, 41); }
.yuzu-runtime-console .yuzu-runtime-log-row-warning.yuzu-runtime-log-row-selected { background-color: rgba(221, 134, 41, 0.20); }
.yuzu-runtime-console .yuzu-runtime-log-row-error { border-left-color: rgb(242, 90, 90); }
.yuzu-runtime-console .yuzu-runtime-log-row-error .yuzu-runtime-log-row-message { color: rgb(242, 90, 90); }
.yuzu-runtime-console .yuzu-runtime-log-row-error.yuzu-runtime-log-row-selected { background-color: rgba(242, 90, 90, 0.20); }
.yuzu-runtime-console .yuzu-runtime-log-row-selected .yuzu-runtime-log-row-message { color: rgb(249, 250, 251); }

.yuzu-runtime-console .yuzu-runtime-log-splitter { height: 12px; min-height: 12px; flex-grow: 0; flex-shrink: 0; align-items: center; justify-content: center; background-color: rgb(27, 27, 28); border-top-width: 1px; border-bottom-width: 1px; border-top-color: rgba(255, 255, 255, 0.06); border-bottom-color: rgba(255, 255, 255, 0.06); }
.yuzu-runtime-console .yuzu-runtime-log-splitter:hover,
.yuzu-runtime-console .yuzu-runtime-log-splitter-active { background-color: rgba(96, 165, 250, 0.18); border-top-color: rgb(96, 165, 250); border-bottom-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-log-splitter-handle { width: 64px; height: 4px; background-color: rgb(84, 85, 87); border-radius: 2px; }
.yuzu-runtime-console .yuzu-runtime-log-splitter:hover .yuzu-runtime-log-splitter-handle,
.yuzu-runtime-console .yuzu-runtime-log-splitter-active .yuzu-runtime-log-splitter-handle { background-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-log-detail { height: 138px; min-height: 0; flex-grow: 0; flex-shrink: 0; }
.yuzu-runtime-console .yuzu-runtime-log-detail .yuzu-runtime-console-pan-content { padding: 8px 20px 10px 8px; }
.yuzu-runtime-console .yuzu-runtime-log-detail-header { flex-shrink: 0; min-height: 20px; margin-bottom: 5px; padding-bottom: 4px; color: rgb(249, 250, 251); font-size: 12px; -unity-font-style: bold; white-space: nowrap; text-overflow: ellipsis; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.08); }
.yuzu-runtime-console .yuzu-runtime-log-detail-text { flex-shrink: 0; min-height: 18px; color: rgb(207, 211, 214); font-size: 12px; white-space: normal; -unity-text-align: upper-left; }
.yuzu-runtime-console .yuzu-runtime-log-detail-empty { color: rgb(129, 133, 140); -unity-font-style: italic; }
