/* Package-owned Runtime Console skin. Native controls are input engines only and are reset below the console root. */

.yuzu-debug-console-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

.yuzu-runtime-console {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 980px;
    height: 520px;
    min-width: 320px;
    min-height: 260px;
    flex-direction: column;
    background-color: rgb(21, 21, 23);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    color: rgb(207, 211, 214);
    font-size: 14px;
    overflow: hidden;
}

.yuzu-runtime-console-collapsed {
    height: 44px;
    min-height: 44px;
}

.yuzu-runtime-console-header {
    height: 44px;
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    padding: 0 38px 0 14px;
    flex-shrink: 0;
    background-color: rgb(44, 44, 46);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.yuzu-runtime-console-title {
    min-width: 0;
    min-height: 24px;
    color: rgb(249, 250, 251);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.yuzu-runtime-console-drag-hint {
    flex-grow: 1;
    min-width: 0;
    min-height: 18px;
    margin-left: 10px;
    color: rgb(129, 133, 140);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.yuzu-runtime-console-collapse-button {
    position: absolute;
    right: 34px;
    top: 8px;
    width: 28px;
    min-width: 28px;
    height: 28px;
    min-height: 28px;
    margin: 0;
    padding: 0;
    background-image: none;
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
}
.yuzu-runtime-console-collapse-button:hover { background-color: rgba(255, 255, 255, 0.10); }
.yuzu-runtime-console-collapse-button:active,
.yuzu-runtime-console-collapse-button:focus { background-color: rgba(255, 255, 255, 0.14); }
.yuzu-runtime-console-collapse-icon {
    position: relative;
    width: 14px;
    min-width: 14px;
    height: 10px;
    min-height: 10px;
    margin-top: 2px;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(207, 211, 214);
    border-bottom-color: rgb(207, 211, 214);
    rotate: -45deg;
}
.yuzu-runtime-console-collapse-icon-open { margin-top: -2px; rotate: 135deg; }

.yuzu-runtime-console-tab-bar {
    min-height: 46px;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 7px 38px 7px 10px;
    background-color: rgb(27, 27, 28);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.yuzu-runtime-console-tab-button {
    min-width: 0;
    max-width: 160px;
    height: 32px;
    margin: 0 4px 0 0;
    padding: 4px 12px;
    flex-grow: 0;
    flex-shrink: 1;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 16px;
    color: rgb(173, 178, 184);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.yuzu-runtime-console-tab-button:hover { background-color: rgba(255, 255, 255, 0.08); color: rgb(249, 250, 251); }
.yuzu-runtime-console-tab-button:active,
.yuzu-runtime-console-tab-button:focus { background-color: rgba(255, 255, 255, 0.14); border-color: rgba(255, 255, 255, 0.16); color: rgb(249, 250, 251); }
.yuzu-runtime-console-tab-button-active,
.yuzu-runtime-console-tab-button-active:hover { background-color: rgba(96, 165, 250, 0.18); border-color: rgb(96, 165, 250); color: rgb(249, 250, 251); -unity-font-style: bold; }
.yuzu-runtime-console-tab-button:disabled { opacity: 0.4; background-image: none; }

.yuzu-runtime-console-content,
.yuzu-runtime-console-tab-root { flex-grow: 1; min-height: 0; background-color: rgb(21, 21, 23); }
.yuzu-runtime-console-tab-root { flex-direction: column; }
.yuzu-runtime-console-page { flex-grow: 1; min-height: 0; padding: 12px; background-color: rgb(21, 21, 23); }

.yuzu-runtime-console-pan-view { flex-grow: 1; min-height: 0; position: relative; overflow: hidden; }
.yuzu-runtime-console-pan-content { position: absolute; left: 0; right: 0; top: 0; padding-right: 12px; flex-direction: column; flex-shrink: 0; }
.yuzu-runtime-console-pan-scrollbar { position: absolute; top: 4px; right: 0; bottom: 4px; width: 8px; background-color: transparent; }
.yuzu-runtime-console-pan-scrollbar-thumb { position: absolute; left: 0; right: 0; min-height: 30px; background-color: rgb(60, 60, 61); border-width: 0; border-radius: 4px; }
.yuzu-runtime-console-pan-scrollbar-thumb:hover,
.yuzu-runtime-console-pan-scrollbar-thumb-active { background-color: rgb(84, 85, 87); }

.yuzu-runtime-console .yuzu-debug-label {
    min-width: 0;
    min-height: 20px;
    margin: 0;
    padding: 0;
    color: rgb(207, 211, 214);
    font-size: 13px;
    -unity-text-align: middle-left;
    white-space: normal;
}
.yuzu-runtime-console .yuzu-debug-label-muted { color: rgb(129, 133, 140); }

.yuzu-runtime-console-toolbar {
    min-height: 46px;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 7px 10px;
    background-color: rgb(27, 27, 28);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.yuzu-runtime-console-button {
    height: 32px;
    margin: 0 8px 0 0;
    padding: 4px 12px;
    flex-shrink: 0;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    color: rgb(249, 250, 251);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.yuzu-runtime-console-button:hover { background-color: rgba(255, 255, 255, 0.08); }
.yuzu-runtime-console-button:active,
.yuzu-runtime-console-button:focus,
.yuzu-runtime-console-button:checked { background-color: rgba(255, 255, 255, 0.14); border-color: rgb(96, 165, 250); }
.yuzu-runtime-console-button:disabled { opacity: 0.4; background-image: none; }

.yuzu-runtime-console-card {
    margin: 0 0 10px 0;
    padding: 12px;
    background-color: rgb(35, 35, 36);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}
.yuzu-runtime-console-card-title { min-height: 24px; margin-bottom: 8px; color: rgb(249, 250, 251); font-size: 16px; -unity-font-style: bold; }
.yuzu-runtime-console-field-row { min-width: 0; min-height: 28px; flex-direction: row; align-items: flex-start; margin-bottom: 4px; }
.yuzu-runtime-console-field-label { width: 148px; min-width: 148px; min-height: 22px; margin-right: 10px; color: rgb(173, 178, 184); font-size: 14px; white-space: nowrap; text-overflow: ellipsis; }
.yuzu-runtime-console-field-value { flex-grow: 1; min-width: 0; min-height: 22px; color: rgb(207, 211, 214); font-size: 14px; white-space: normal; }
.yuzu-runtime-console-message { min-width: 0; margin: 5px 0; padding: 7px 9px; border-left-width: 3px; border-radius: 8px; }

.yuzu-runtime-console-resize-grip {
    position: absolute;
    right: 4px;
    bottom: 4px;
    width: 40px;
    height: 40px;
    background-color: transparent;
    border-width: 0;
}
.yuzu-runtime-console-resize-grip:hover,
.yuzu-runtime-console-resize-grip:active { background-color: transparent; }
.yuzu-runtime-console-resize-line {
    position: absolute;
    right: 7px;
    bottom: 10px;
    width: 13px;
    height: 2px;
    background-color: rgb(173, 178, 184);
    border-radius: 1px;
    rotate: -45deg;
}
.yuzu-runtime-console-resize-line-short { right: 6px; bottom: 5px; width: 8px; }
.yuzu-runtime-console-resize-grip:hover .yuzu-runtime-console-resize-line,
.yuzu-runtime-console-resize-grip:active .yuzu-runtime-console-resize-line { background-color: rgb(96, 165, 250); }

/* Native field reset, intentionally scoped under the console root. */
.yuzu-runtime-console .yuzu-runtime-console-control.unity-base-field { min-width: 0; min-height: 32px; margin: 2px 0; padding: 0; font-size: 14px; }
.yuzu-runtime-console .yuzu-runtime-console-control .unity-base-field__label { width: 148px; min-width: 148px; min-height: 22px; margin: 0 10px 0 0; padding: 0; color: rgb(173, 178, 184); font-size: 14px; -unity-text-align: middle-left; }
.yuzu-runtime-console .yuzu-runtime-console-control .unity-base-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control .unity-base-text-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control .unity-integer-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control .unity-float-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control .unity-double-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control .unity-enum-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control .unity-base-popup-field__input {
    min-width: 0;
    min-height: 32px;
    padding: 4px 8px;
    background-image: none;
    background-color: rgb(35, 35, 36);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: rgb(249, 250, 251);
    font-size: 14px;
    --unity-cursor-color: rgb(249, 250, 251);
    --unity-selection-color: rgba(96, 165, 250, 0.34);
}
.yuzu-runtime-console .yuzu-runtime-console-control .unity-base-field__input:hover,
.yuzu-runtime-console .yuzu-runtime-console-control .unity-base-text-field__input:hover { background-color: rgb(44, 44, 46); border-color: rgba(255, 255, 255, 0.16); }
.yuzu-runtime-console .yuzu-runtime-console-control .unity-base-field__input:focus,
.yuzu-runtime-console .yuzu-runtime-console-control .unity-base-text-field__input:focus { border-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-base-field--invalid .unity-base-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control.unity-base-field--invalid .unity-base-text-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control.yuzu-debug-invalid .unity-base-field__input,
.yuzu-runtime-console .yuzu-runtime-console-control.yuzu-debug-invalid .unity-base-text-field__input { border-color: rgb(242, 90, 90); }
.yuzu-runtime-console .yuzu-runtime-console-control:disabled { opacity: 0.4; }

.yuzu-runtime-console .yuzu-runtime-console-control.unity-toggle { min-height: 32px; margin: 2px 8px 2px 0; }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-toggle > .unity-toggle__input { min-width: 0; min-height: 32px; margin: 0; padding: 0; align-items: center; }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-toggle .unity-toggle__label { min-width: 0; min-height: 22px; margin: 0; padding: 0; color: rgb(207, 211, 214); font-size: 14px; }
.yuzu-runtime-console .yuzu-runtime-console-toggle > .unity-toggle__input { background-image: none; background-color: transparent; border-width: 0; }
.yuzu-runtime-console .yuzu-runtime-console-toggle .unity-toggle__checkmark { display: none; width: 0; min-width: 0; height: 0; min-height: 0; margin: 0; background-image: none; background-color: transparent; border-width: 0; }
.yuzu-runtime-console .yuzu-runtime-console-toggle .unity-toggle__label { width: 148px; min-width: 148px; margin: 0 10px 0 0; color: rgb(173, 178, 184); font-size: 14px; -unity-text-align: middle-left; }
.yuzu-runtime-console .yuzu-runtime-console-toggle-status { flex-grow: 1; min-width: 30px; min-height: 20px; margin-right: 8px; color: rgb(129, 133, 140); font-size: 12px; -unity-text-align: middle-right; }
.yuzu-runtime-console .yuzu-runtime-console-toggle-track { position: relative; width: 34px; min-width: 34px; height: 20px; min-height: 20px; flex-shrink: 0; background-color: rgb(53, 54, 56); border-width: 1px; border-color: rgba(255, 255, 255, 0.16); border-radius: 10px; }
.yuzu-runtime-console .yuzu-runtime-console-toggle-thumb { position: absolute; left: 2px; top: 2px; width: 14px; min-width: 14px; height: 14px; min-height: 14px; background-color: rgb(207, 211, 214); border-radius: 7px; }
.yuzu-runtime-console .yuzu-runtime-console-toggle-on .yuzu-runtime-console-toggle-status { color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-console-toggle-on .yuzu-runtime-console-toggle-track { background-color: rgb(96, 165, 250); border-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-console-toggle-on .yuzu-runtime-console-toggle-thumb { left: 16px; background-color: rgb(249, 250, 251); }

.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout { margin: 0; padding: 0; }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__toggle { min-height: 38px; margin: 0; padding: 6px 10px; background-image: none; background-color: rgb(44, 44, 46); border-radius: 10px; }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__toggle:hover { background-color: rgba(255, 255, 255, 0.08); }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__toggle:focus,
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__toggle:active { background-color: rgba(255, 255, 255, 0.14); }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__toggle > .unity-toggle__input { min-width: 0; min-height: 28px; margin: 0; padding: 0; align-items: center; }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__toggle .unity-toggle__label { min-width: 0; min-height: 22px; color: rgb(249, 250, 251); font-size: 14px; white-space: nowrap; text-overflow: ellipsis; }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__toggle .unity-foldout__checkmark { display: none; width: 0; min-width: 0; height: 0; min-height: 0; margin: 0; background-image: none; background-color: transparent; border-width: 0; }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__toggle:checked .unity-foldout__checkmark { background-image: none; background-color: transparent; }
.yuzu-runtime-console .yuzu-runtime-console-control.unity-foldout > .unity-foldout__content { margin: 4px 0 0 8px; padding: 0 0 0 10px; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.06); }

.yuzu-runtime-console .yuzu-runtime-console-switch { position: relative; min-height: 28px; padding-left: 28px; border-radius: 14px; }
.yuzu-runtime-console .yuzu-runtime-console-switch-indicator { position: absolute; left: 10px; top: 9px; width: 10px; min-width: 10px; height: 10px; min-height: 10px; background-color: rgb(129, 133, 140); border-radius: 5px; }
.yuzu-runtime-console .yuzu-runtime-console-switch-on { background-color: rgba(96, 165, 250, 0.18); border-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-console-switch-on .yuzu-runtime-console-switch-indicator { background-color: rgb(96, 165, 250); }
.yuzu-runtime-console .yuzu-runtime-console-switch-off { background-color: transparent; }
.yuzu-runtime-console .yuzu-runtime-console-switch-blocked { opacity: 0.4; }

.yuzu-runtime-console .yuzu-runtime-console-search-icon {
    position: absolute;
    left: 10px;
    top: 9px;
    width: 10px;
    height: 10px;
    border-width: 2px;
    border-color: rgb(129, 133, 140);
    border-radius: 5px;
}
.yuzu-runtime-console .yuzu-runtime-console-search-icon-handle {
    position: absolute;
    right: -5px;
    bottom: -3px;
    width: 6px;
    height: 2px;
    background-color: rgb(129, 133, 140);
    border-radius: 1px;
    rotate: 45deg;
}
.yuzu-runtime-console .yuzu-runtime-console-search-placeholder {
    position: absolute;
    left: 30px;
    top: 7px;
    min-height: 18px;
    color: rgb(129, 133, 140);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.yuzu-runtime-console .yuzu-runtime-console-disclosure {
    width: 10px;
    min-width: 10px;
    height: 10px;
    min-height: 10px;
    margin: 0 10px 0 3px;
    flex-shrink: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: rgb(173, 178, 184);
    border-bottom-color: rgb(173, 178, 184);
    rotate: -45deg;
}
.yuzu-runtime-console .yuzu-runtime-console-disclosure-open { margin-top: -4px; rotate: 45deg; }

.yuzu-runtime-console-help-popup {
    position: absolute;
    max-width: 340px;
    padding: 8px 10px;
    background-image: none;
    background-color: rgb(53, 54, 56);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 12px;
}
.yuzu-runtime-console-help-text { min-height: 18px; margin: 0; padding: 0; color: rgb(249, 250, 251); font-size: 12px; white-space: normal; }
