.yuzu-runtime-console .yuzu-runtime-tool-item {
    margin-bottom: 8px;
    padding: 0;
    background-color: rgb(44, 44, 46);
    border-width: 0;
    border-radius: 10px;
    overflow: hidden;
}
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle {
    min-height: 40px;
    margin: 0;
    padding: 6px 10px;
    background-image: none;
    background-color: rgb(44, 44, 46);
    border-radius: 11px;
}
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle:hover { background-color: rgba(255, 255, 255, 0.08); }
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle:focus,
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle:active { background-color: rgba(255, 255, 255, 0.14); }
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle > .unity-toggle__input { min-width: 0; min-height: 28px; margin: 0; padding: 0; align-items: center; }
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle .unity-toggle__label { min-width: 0; min-height: 22px; color: rgb(249, 250, 251); font-size: 14px; white-space: nowrap; text-overflow: ellipsis; }
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle .unity-foldout__checkmark { display: none; width: 0; min-width: 0; height: 0; min-height: 0; margin: 0; background-image: none; background-color: transparent; border-width: 0; }
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle:checked .unity-foldout__checkmark { background-image: none; background-color: transparent; }
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__content { margin: 0; padding: 10px 12px 12px 12px; background-color: rgb(35, 35, 36); border-left-width: 0; }
.yuzu-runtime-console .yuzu-runtime-tool-item > .unity-foldout__toggle:disabled { opacity: 0.4; background-image: none; }
.yuzu-runtime-console .yuzu-runtime-tool-header { min-width: 0; min-height: 34px; margin-bottom: 8px; flex-direction: row; align-items: center; }
.yuzu-runtime-console .yuzu-runtime-tool-description { flex-grow: 1; min-width: 0; min-height: 22px; color: rgb(173, 178, 184); font-size: 14px; white-space: normal; }
