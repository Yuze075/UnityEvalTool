    border-right-color: rgba(255, 105, 112, 0.76);
    border-bottom-color: rgba(255, 105, 112, 0.76);
    border-left-color: rgba(255, 105, 112, 0.76);
}

.yuzu-debug-debug-layer .yuzu-debug-tone-blue {
