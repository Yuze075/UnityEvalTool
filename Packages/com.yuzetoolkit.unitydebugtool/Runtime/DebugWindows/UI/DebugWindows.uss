.yuzu-debug-debug-layer .yuzu-debug-field.unity-toggle:checked:hover .unity-toggle__checkmark,
.yuzu-debug-debug-layer .yuzu-debug-field.unity-toggle:checked:focus .unity-toggle__checkmark,
