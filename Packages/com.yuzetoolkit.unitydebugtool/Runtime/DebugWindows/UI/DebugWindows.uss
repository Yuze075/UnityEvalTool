    border-right-color: rgba(91, 174, 255, 0.76);
    border-bottom-color: rgba(91, 174, 255, 0.76);
    border-left-color: rgba(91, 174, 255, 0.76);
}

.yuzu-debug-debug-layer .yuzu-debug-tone-yellow {
    color: rgb(245, 211, 92);
}

.yuzu-debug-debug-layer .yuzu-debug-button.yuzu-debug-tone-yellow {
