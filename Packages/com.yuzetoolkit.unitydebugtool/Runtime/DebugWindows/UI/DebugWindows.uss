}

.yuzu-debug-debug-layer .yuzu-debug-button.yuzu-debug-tone-danger,
.yuzu-debug-debug-layer .yuzu-debug-button.yuzu-debug-tone-red {
    background-color: rgba(176, 48, 58, 0.44);
