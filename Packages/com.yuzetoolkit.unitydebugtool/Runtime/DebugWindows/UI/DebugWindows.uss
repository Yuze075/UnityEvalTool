.yuzu-debug-debug-layer .yuzu-debug-tone-pink {
    color: rgb(244, 133, 207);
}

.yuzu-debug-debug-layer .yuzu-debug-button.yuzu-debug-tone-pink {
    background-color: rgba(159, 66, 132, 0.44);
    border-top-color: rgba(244, 133, 207, 0.76);
    border-right-color: rgba(244, 133, 207, 0.76);
    border-bottom-color: rgba(244, 133, 207, 0.76);
    border-left-color: rgba(244, 133, 207, 0.76);
