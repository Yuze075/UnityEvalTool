/* Codex-inspired owned surface. These final rules deliberately replace the legacy
   teal/default-control treatment above while keeping the existing layout contract. */
.yuzu-debug-debug-layer .yuzu-debug-window {
    margin: 12px 0 0 12px;
}

.yuzu-debug-debug-layer .yuzu-debug-window-background {
    background-color: rgba(28, 28, 30, 0.97);
    border-top-color: rgba(255, 255, 255, 0.10);
