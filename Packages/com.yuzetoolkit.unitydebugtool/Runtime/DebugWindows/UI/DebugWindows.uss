/* Native EnumField is deliberately replaced by DebugEnumDropdown so its popup remains
   inside the themed runtime hierarchy instead of opening Unity's GenericDropdownMenu. */
.yuzu-debug-debug-layer .yuzu-debug-enum-field {
    position: relative;
    min-width: 0;
    min-height: 36px;
    margin: 1px 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.yuzu-debug-debug-layer .yuzu-debug-enum-label {
    width: 156px;
    min-width: 156px;
    margin-right: 8px;
    color: rgb(151, 151, 156);
