/* Package-owned DebugWindows skin. Every native UI Toolkit control is scoped to the module layer. */

.yuzu-debug-debug-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: flex-start;
    padding: 12px;
}

.yuzu-debug-debug-layer .yuzu-debug-window {
    min-width: 360px;
    max-width: 520px;
    margin-right: 10px;
    color: rgb(249, 250, 251);
}

.yuzu-debug-debug-layer .yuzu-debug-window-background {
    background-color: rgb(27, 27, 28);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    overflow: hidden;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout {
    margin: 0;
    padding: 0;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle {
    min-height: 36px;
    margin: 0;
    padding: 4px 10px;
    background-image: none;
    background-color: rgb(35, 35, 36);
    border-width: 0;
    border-radius: 10px;
    color: rgb(249, 250, 251);
}

.yuzu-debug-debug-layer .yuzu-debug-window-background > .yuzu-debug-foldout > .yuzu-debug-header {
    min-height: 48px;
    padding: 12px 14px;
    background-color: rgb(44, 44, 46);
    border-radius: 11px;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle:active,
.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle:focus {
    background-color: rgba(255, 255, 255, 0.14);
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle:disabled {
    opacity: 0.4;
    background-image: none;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle > .unity-toggle__input {
    min-width: 0;
    min-height: 28px;
    margin: 0;
    padding: 0;
    align-items: center;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle .unity-foldout__checkmark {
    display: none;
    width: 0;
    min-width: 0;
    height: 0;
    min-height: 0;
    margin: 0;
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle:checked .unity-foldout__checkmark {
    background-image: none;
    background-color: transparent;
}

.yuzu-debug-debug-layer .yuzu-debug-disclosure {
    width: 10px;
    min-width: 10px;
    height: 10px;
    min-height: 10px;
    margin: 0 10px 0 3px;
    flex-shrink: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: rgb(173, 178, 184);
    border-bottom-color: rgb(173, 178, 184);
    rotate: -45deg;
}

.yuzu-debug-debug-layer .yuzu-debug-disclosure-open {
    margin-top: -4px;
    rotate: 45deg;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle .unity-toggle__label {
    flex-grow: 1;
    min-width: 0;
    min-height: 20px;
    margin: 0;
    padding: 0;
    color: rgb(249, 250, 251);
    font-size: 13px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.yuzu-debug-debug-layer .yuzu-debug-window-background > .yuzu-debug-foldout > .yuzu-debug-header .unity-toggle__label {
    min-height: 24px;
    font-size: 16px;
    -unity-font-style: bold;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__content {
    margin: 4px 0 0 8px;
    padding: 0 0 0 10px;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
}

.yuzu-debug-debug-layer .yuzu-debug-window-background > .yuzu-debug-foldout > .unity-foldout__content {
    margin: 0;
    padding: 0;
    border-left-width: 0;
}

.yuzu-debug-debug-layer .yuzu-debug-window-content {
    max-height: 600px;
    padding: 10px 12px 14px 12px;
    background-color: rgb(21, 21, 23);
}

.yuzu-debug-debug-layer .yuzu-debug-window-content .unity-scroll-view__content-container {
    min-width: 0;
    max-width: 100%;
}

.yuzu-debug-debug-layer .yuzu-debug-window-content .unity-scroll-view__horizontal-scroller {
    display: none;
}

.yuzu-debug-debug-layer .yuzu-debug-row,
.yuzu-debug-debug-layer .yuzu-debug-slider-row,
.yuzu-debug-debug-layer .yuzu-debug-enum-field {
    min-width: 0;
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.yuzu-debug-debug-layer .yuzu-debug-inline-group {
    min-width: 0;
    margin-bottom: 6px;
}

.yuzu-debug-debug-layer .yuzu-debug-inline-group-row { flex-direction: row; align-items: center; overflow: hidden; }
.yuzu-debug-debug-layer .yuzu-debug-inline-group-column { flex-direction: column; align-items: stretch; }

.yuzu-debug-debug-layer .yuzu-debug-inline-field-label {
    width: 124px;
    min-width: 124px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 10px;
    color: rgb(173, 178, 184);
    font-size: 13px;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.yuzu-debug-debug-layer .yuzu-debug-inline-group-row > .yuzu-debug-readonly-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.yuzu-debug-debug-layer .yuzu-debug-section {
    min-height: 22px;
    margin: 12px 0 6px 0;
    color: rgb(249, 250, 251);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.yuzu-debug-debug-layer .yuzu-debug-first-section { margin-top: 0; }

.yuzu-debug-debug-layer .yuzu-debug-label,
.yuzu-debug-debug-layer .yuzu-debug-readonly-label,
.yuzu-debug-debug-layer .yuzu-debug-state-label {
    min-width: 0;
    min-height: 22px;
    margin: 0;
    padding: 0;
    color: rgb(207, 211, 214);
    font-size: 14px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.yuzu-debug-debug-layer .yuzu-debug-label-muted { color: rgb(129, 133, 140); }

.yuzu-debug-debug-layer .yuzu-debug-readonly-label {
    flex-grow: 1;
    padding: 4px 8px;
    background-color: rgb(35, 35, 36);
    border-radius: 8px;
}

.yuzu-debug-debug-layer .yuzu-debug-tag {
    min-height: 20px;
    margin-right: 6px;
    padding: 1px 8px;
    background-color: rgb(53, 54, 56);
    border-radius: 10px;
    color: rgb(207, 211, 214);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.yuzu-debug-debug-layer .yuzu-debug-button,
.yuzu-debug-debug-layer .yuzu-debug-segment-button {
    min-height: 28px;
    min-width: 0;
    margin: 0 6px 0 0;
    padding: 3px 10px;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    color: rgb(249, 250, 251);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.yuzu-debug-debug-layer .yuzu-debug-button:hover,
.yuzu-debug-debug-layer .yuzu-debug-segment-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.yuzu-debug-debug-layer .yuzu-debug-button:active,
.yuzu-debug-debug-layer .yuzu-debug-button:focus,
.yuzu-debug-debug-layer .yuzu-debug-segment-button:active,
.yuzu-debug-debug-layer .yuzu-debug-segment-button:focus,
.yuzu-debug-debug-layer .yuzu-debug-active {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgb(96, 165, 250);
}

.yuzu-debug-debug-layer .yuzu-debug-button:disabled,
.yuzu-debug-debug-layer .yuzu-debug-segment-button:disabled { opacity: 0.4; background-image: none; }

.yuzu-debug-debug-layer .yuzu-debug-segmented-row {
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.yuzu-debug-debug-layer .yuzu-debug-state-button { flex-grow: 1; }
.yuzu-debug-debug-layer .yuzu-debug-primary-button {
    background-color: rgb(96, 165, 250);
    border-color: rgb(96, 165, 250);
    color: rgb(21, 21, 23);
    -unity-font-style: bold;
}
.yuzu-debug-debug-layer .yuzu-debug-primary-button:hover { background-color: rgb(126, 190, 255); border-color: rgb(126, 190, 255); }
.yuzu-debug-debug-layer .yuzu-debug-primary-button:active,
.yuzu-debug-debug-layer .yuzu-debug-primary-button:focus { background-color: rgb(96, 165, 250); border-color: rgb(249, 250, 251); }

.yuzu-debug-debug-layer .yuzu-debug-icon-button {
    width: 28px;
    min-width: 28px;
    height: 28px;
    min-height: 28px;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
}
.yuzu-debug-debug-layer .yuzu-debug-previous-icon,
.yuzu-debug-debug-layer .yuzu-debug-next-icon {
    width: 16px;
    min-width: 16px;
    height: 16px;
    min-height: 16px;
    margin: 0;
    border-width: 0;
}

.yuzu-debug-debug-layer .yuzu-debug-bool-button {
    width: 100%;
    min-width: 0;
    min-height: 36px;
    padding: 4px 8px 4px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(35, 35, 36);
    border-radius: 8px;
}
.yuzu-debug-debug-layer .yuzu-debug-bool-button-label { flex-grow: 1; min-width: 0; min-height: 20px; color: rgb(249, 250, 251); font-size: 13px; -unity-text-align: middle-left; }
.yuzu-debug-debug-layer .yuzu-debug-bool-button-status { width: 30px; min-width: 30px; min-height: 18px; margin-right: 8px; color: rgb(173, 178, 184); font-size: 12px; -unity-text-align: middle-right; }
.yuzu-debug-debug-layer .yuzu-debug-bool-switch { position: relative; width: 36px; min-width: 36px; height: 20px; min-height: 20px; flex-shrink: 0; background-color: rgb(27, 27, 28); border-width: 1px; border-color: rgb(84, 85, 87); border-radius: 7px; }
.yuzu-debug-debug-layer .yuzu-debug-bool-switch-thumb { position: absolute; left: 3px; top: 3px; width: 12px; min-width: 12px; height: 12px; min-height: 12px; background-color: rgb(173, 178, 184); border-width: 0; border-radius: 4px; }
.yuzu-debug-debug-layer .yuzu-debug-bool-button.yuzu-debug-active { background-color: rgba(96, 165, 250, 0.12); border-color: rgb(96, 165, 250); }
.yuzu-debug-debug-layer .yuzu-debug-bool-button.yuzu-debug-active .yuzu-debug-bool-button-status { color: rgb(96, 165, 250); }
.yuzu-debug-debug-layer .yuzu-debug-bool-button.yuzu-debug-active .yuzu-debug-bool-switch { background-color: rgb(96, 165, 250); border-color: rgb(96, 165, 250); }
.yuzu-debug-debug-layer .yuzu-debug-bool-button.yuzu-debug-active .yuzu-debug-bool-switch-thumb { left: 19px; background-color: rgb(21, 21, 23); }
.yuzu-debug-debug-layer .yuzu-debug-tone-success.yuzu-debug-active,
.yuzu-debug-debug-layer .yuzu-debug-tone-green.yuzu-debug-active { color: rgb(34, 197, 94); }
.yuzu-debug-debug-layer .yuzu-debug-tone-danger.yuzu-debug-active,
.yuzu-debug-debug-layer .yuzu-debug-tone-red.yuzu-debug-active { color: rgb(242, 90, 90); }
.yuzu-debug-debug-layer .yuzu-debug-tone-yellow.yuzu-debug-active { color: rgb(221, 134, 41); }
.yuzu-debug-debug-layer .yuzu-debug-tone-blue.yuzu-debug-active { color: rgb(96, 165, 250); }
.yuzu-debug-debug-layer .yuzu-debug-tone-pink.yuzu-debug-active { color: rgb(244, 114, 182); }
.yuzu-debug-debug-layer .yuzu-debug-tone-white.yuzu-debug-active { color: rgb(249, 250, 251); }

.yuzu-debug-debug-layer .yuzu-debug-field {
    min-width: 0;
    min-height: 32px;
    margin: 0 0 6px 0;
    padding: 0;
}

.yuzu-debug-debug-layer .yuzu-debug-field .unity-base-field__label,
.yuzu-debug-debug-layer .yuzu-debug-enum-label {
    width: 124px;
    min-width: 124px;
    margin: 0 10px 0 0;
    padding: 0;
    color: rgb(173, 178, 184);
    font-size: 13px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.yuzu-debug-debug-layer .yuzu-debug-field-no-label .unity-base-field__label { display: none; }

.yuzu-debug-debug-layer .yuzu-debug-field .unity-base-field__input,
.yuzu-debug-debug-layer .yuzu-debug-field .unity-base-text-field__input {
    min-width: 0;
    min-height: 32px;
    padding: 4px 8px;
    background-image: none;
    background-color: rgb(35, 35, 36);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: rgb(249, 250, 251);
    font-size: 14px;
    --unity-cursor-color: rgb(249, 250, 251);
    --unity-selection-color: rgba(96, 165, 250, 0.34);
}

.yuzu-debug-debug-layer .yuzu-debug-field .unity-base-field__input:hover,
.yuzu-debug-debug-layer .yuzu-debug-field .unity-base-text-field__input:hover {
    background-color: rgb(44, 44, 46);
    border-color: rgba(255, 255, 255, 0.16);
}

.yuzu-debug-debug-layer .yuzu-debug-field .unity-base-field__input:focus,
.yuzu-debug-debug-layer .yuzu-debug-field .unity-base-text-field__input:focus {
    border-color: rgb(96, 165, 250);
}

.yuzu-debug-debug-layer .yuzu-debug-field:disabled { opacity: 0.4; }

.yuzu-debug-debug-layer .yuzu-debug-field.unity-toggle > .unity-toggle__input {
    min-height: 32px;
    margin: 0;
    padding: 0;
    align-items: center;
}

.yuzu-debug-debug-layer .yuzu-debug-owned-toggle > .unity-toggle__input { background-image: none; background-color: transparent; border-width: 0; }
.yuzu-debug-debug-layer .yuzu-debug-owned-toggle .unity-toggle__checkmark { display: none; width: 0; min-width: 0; height: 0; min-height: 0; margin: 0; background-image: none; background-color: transparent; border-width: 0; }
.yuzu-debug-debug-layer .yuzu-debug-owned-toggle .unity-toggle__label { width: 124px; min-width: 124px; margin: 0 10px 0 0; color: rgb(173, 178, 184); font-size: 13px; -unity-text-align: middle-left; }
.yuzu-debug-debug-layer .yuzu-debug-owned-toggle-status { flex-grow: 1; min-width: 30px; min-height: 18px; margin-right: 8px; color: rgb(173, 178, 184); font-size: 12px; -unity-text-align: middle-right; }
.yuzu-debug-debug-layer .yuzu-debug-owned-toggle.yuzu-debug-active .yuzu-debug-owned-toggle-status { color: rgb(96, 165, 250); }
.yuzu-debug-debug-layer .yuzu-debug-owned-toggle.yuzu-debug-active .yuzu-debug-bool-switch { background-color: rgb(96, 165, 250); border-color: rgb(96, 165, 250); }
.yuzu-debug-debug-layer .yuzu-debug-owned-toggle.yuzu-debug-active .yuzu-debug-bool-switch-thumb { left: 19px; background-color: rgb(21, 21, 23); }

.yuzu-debug-debug-layer .yuzu-debug-slider-row { align-items: center; }
.yuzu-debug-debug-layer .yuzu-debug-slider { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 32px; margin: 0; padding: 0; }
.yuzu-debug-debug-layer .yuzu-debug-slider > .unity-base-field__label {
    width: 124px;
    min-width: 124px;
    margin: 0 10px 0 0;
    padding: 0;
    color: rgb(173, 178, 184);
    font-size: 13px;
    -unity-text-align: middle-left;
}
.yuzu-debug-debug-layer .yuzu-debug-slider > .unity-base-slider__input { flex-grow: 1; flex-shrink: 1; min-width: 72px; min-height: 28px; margin: 0; padding: 0 8px; overflow: visible; }
.yuzu-debug-debug-layer .yuzu-debug-slider .unity-base-slider__tracker {
    position: relative;
    height: 8px;
    background-image: none;
    background-color: rgb(27, 27, 28);
    border-width: 1px;
    border-color: rgb(84, 85, 87);
    border-radius: 4px;
    overflow: visible;
}
.yuzu-debug-debug-layer .yuzu-debug-slider .unity-base-slider__dragger-border { opacity: 0; background-image: none; background-color: transparent; border-width: 0; }
.yuzu-debug-debug-layer .yuzu-debug-slider .unity-base-slider__dragger {
    opacity: 0;
    width: 20px;
    height: 20px;
    background-image: none;
    background-color: transparent;
    border-width: 0;
}
.yuzu-debug-debug-layer .yuzu-debug-slider-filler { position: absolute; left: 0; top: 1px; bottom: 1px; background-color: rgb(96, 165, 250); border-radius: 3px; }
.yuzu-debug-debug-layer .yuzu-debug-slider-thumb { position: absolute; top: -5px; width: 16px; min-width: 16px; height: 16px; min-height: 16px; margin-left: -8px; background-color: rgb(21, 21, 23); border-width: 3px; border-color: rgb(96, 165, 250); border-radius: 8px; }
.yuzu-debug-debug-layer .yuzu-debug-slider-value,
.yuzu-debug-debug-layer .yuzu-debug-mini-value { width: 64px; min-width: 64px; flex-grow: 0; flex-shrink: 0; color: rgb(207, 211, 214); font-size: 13px; -unity-text-align: middle-right; }

.yuzu-debug-debug-layer .yuzu-debug-progress { min-height: 32px; margin-bottom: 6px; }
.yuzu-debug-debug-layer .yuzu-debug-progress .unity-progress-bar__background {
    min-height: 18px;
    background-image: none;
    background-color: rgb(35, 35, 36);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 9px;
}
.yuzu-debug-debug-layer .yuzu-debug-progress .unity-progress-bar__progress { background-image: none; background-color: rgb(96, 165, 250); border-radius: 8px; }
.yuzu-debug-debug-layer .yuzu-debug-progress .unity-progress-bar__title { min-height: 20px; color: rgb(249, 250, 251); font-size: 12px; -unity-text-align: middle-center; }

.yuzu-debug-debug-layer .yuzu-debug-preview { margin-bottom: 8px; }
.yuzu-debug-debug-layer .yuzu-debug-image { min-height: 104px; background-color: rgb(35, 35, 36); border-radius: 8px; }

.yuzu-debug-debug-layer .yuzu-debug-enum-field { flex-direction: row; }
.yuzu-debug-debug-layer .yuzu-debug-enum-button {
    flex-grow: 1;
    min-width: 0;
    height: 32px;
    padding: 0 8px;
    flex-direction: row;
    align-items: center;
    background-image: none;
    background-color: rgb(35, 35, 36);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
}
.yuzu-debug-debug-layer .yuzu-debug-enum-button:hover { background-color: rgb(44, 44, 46); border-color: rgba(255, 255, 255, 0.16); }
.yuzu-debug-debug-layer .yuzu-debug-enum-button:focus,
.yuzu-debug-debug-layer .yuzu-debug-enum-button:active,
.yuzu-debug-debug-layer .yuzu-debug-enum-button-open { border-color: rgb(96, 165, 250); }
.yuzu-debug-debug-layer .yuzu-debug-enum-button-text { flex-grow: 1; min-width: 0; min-height: 20px; color: rgb(249, 250, 251); font-size: 13px; white-space: nowrap; text-overflow: ellipsis; -unity-text-align: middle-left; }
.yuzu-debug-debug-layer .yuzu-debug-enum-chevron {
    width: 9px;
    min-width: 9px;
    height: 9px;
    min-height: 9px;
    margin: 0 3px 4px 8px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: rgb(173, 178, 184);
    border-bottom-color: rgb(173, 178, 184);
    rotate: 45deg;
}

.yuzu-debug-debug-layer .yuzu-debug-enum-popup {
    position: absolute;
    min-width: 180px;
    max-width: 320px;
    max-height: 320px;
    padding: 4px;
    background-color: rgb(53, 54, 56);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    overflow: hidden;
}
.yuzu-debug-debug-layer .yuzu-debug-enum-popup-scroll { flex-grow: 1; min-height: 0; }
.yuzu-debug-debug-layer .yuzu-debug-enum-popup-item {
    width: 100%;
    min-height: 38px;
    margin: 0;
    padding: 6px 8px;
    flex-direction: row;
    align-items: center;
    background-image: none;
    background-color: transparent;
    border-width: 0;
    border-radius: 10px;
}
.yuzu-debug-debug-layer .yuzu-debug-enum-popup-item:hover,
.yuzu-debug-debug-layer .yuzu-debug-enum-popup-item:focus { background-color: rgba(255, 255, 255, 0.08); }
.yuzu-debug-debug-layer .yuzu-debug-enum-popup-item:active { background-color: rgba(255, 255, 255, 0.14); }
.yuzu-debug-debug-layer .yuzu-debug-enum-popup-item-text { flex-grow: 1; min-width: 0; min-height: 22px; color: rgb(249, 250, 251); font-size: 14px; white-space: nowrap; text-overflow: ellipsis; -unity-text-align: middle-left; }
.yuzu-debug-debug-layer .yuzu-debug-enum-popup-check {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    margin-left: 8px;
    opacity: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: rgb(249, 250, 251);
    border-bottom-color: rgb(249, 250, 251);
    rotate: 45deg;
}
.yuzu-debug-debug-layer .yuzu-debug-enum-popup-item-selected .yuzu-debug-enum-popup-check { opacity: 1; }

.yuzu-debug-debug-layer .unity-scroll-view__vertical-scroller,
.yuzu-debug-debug-layer .unity-scroller--vertical { width: 8px; min-width: 8px; background-color: transparent; }
.yuzu-debug-debug-layer .unity-scroller__low-button,
.yuzu-debug-debug-layer .unity-scroller__high-button { display: none; background-image: none; }
.yuzu-debug-debug-layer .unity-scroller .unity-base-slider__tracker { background-image: none; background-color: transparent; border-width: 0; }
.yuzu-debug-debug-layer .unity-scroller .unity-base-slider__dragger-border { background-image: none; background-color: transparent; border-width: 0; }
.yuzu-debug-debug-layer .unity-scroller .unity-base-slider__dragger {
    width: 8px;
    min-width: 8px;
    background-image: none;
    background-color: rgb(60, 60, 61);
    border-width: 0;
    border-radius: 4px;
}
.yuzu-debug-debug-layer .yuzu-debug-enum-popup .unity-scroller .unity-base-slider__dragger { background-color: rgb(84, 85, 87); }
.yuzu-debug-debug-layer .unity-scroller .unity-base-slider__dragger:hover,
.yuzu-debug-debug-layer .unity-scroller .unity-base-slider__dragger:active { background-color: rgb(84, 85, 87); }
.yuzu-debug-debug-layer .yuzu-debug-enum-popup .unity-scroller .unity-base-slider__dragger:hover,
.yuzu-debug-debug-layer .yuzu-debug-enum-popup .unity-scroller .unity-base-slider__dragger:active { background-color: rgb(101, 103, 107); }
