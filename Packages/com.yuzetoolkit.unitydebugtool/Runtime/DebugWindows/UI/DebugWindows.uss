.yuzu-debug-debug-layer .yuzu-debug-field.unity-toggle:focus .unity-toggle__checkmark,
.yuzu-debug-debug-layer .yuzu-debug-field.unity-toggle:active .unity-toggle__checkmark {
    background-color: rgb(54, 43, 38);
    border-top-color: rgb(255, 122, 69);
    border-right-color: rgb(255, 122, 69);
    border-bottom-color: rgb(255, 122, 69);
    border-left-color: rgb(255, 122, 69);
