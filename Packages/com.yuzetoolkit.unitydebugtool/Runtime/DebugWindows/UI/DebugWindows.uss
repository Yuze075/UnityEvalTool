    border-bottom-color: rgba(255, 255, 255, 0.10);
    border-left-color: rgba(255, 255, 255, 0.10);
    border-radius: 14px;
}

.yuzu-debug-debug-layer .yuzu-debug-foldout > .unity-foldout__toggle {
    min-height: 34px;
