.uet-root {
    color: rgb(224, 225, 230);
    font-size: 12px;
    --unity-selection-color: rgba(96, 165, 250, 0.34);
    --unity-cursor-color: rgb(96, 165, 250);
}

.uet-root .uet-button {
    min-height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    color: rgb(220, 221, 226);
    background-color: rgb(38, 39, 44);
    background-image: none;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(67, 68, 75);
    border-right-color: rgb(67, 68, 75);
    border-top-color: rgb(67, 68, 75);
    border-bottom-color: rgb(67, 68, 75);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.uet-root .uet-button:hover {
    color: rgb(248, 248, 250);
    background-color: rgb(49, 50, 56);
    border-left-color: rgb(91, 92, 101);
    border-right-color: rgb(91, 92, 101);
    border-top-color: rgb(91, 92, 101);
    border-bottom-color: rgb(91, 92, 101);
}

.uet-root .uet-button:active {
    background-color: rgb(27, 28, 32);
    border-left-color: rgb(96, 165, 250);
    border-right-color: rgb(96, 165, 250);
    border-top-color: rgb(96, 165, 250);
    border-bottom-color: rgb(96, 165, 250);
}

.uet-root .uet-button:focus {
    border-left-color: rgb(126, 190, 255);
    border-right-color: rgb(126, 190, 255);
    border-top-color: rgb(126, 190, 255);
    border-bottom-color: rgb(126, 190, 255);
}

.uet-root .uet-button:disabled {
    opacity: 0.42;
    color: rgb(143, 144, 151);
    background-color: rgb(29, 30, 34);
    border-left-color: rgb(48, 49, 54);
    border-right-color: rgb(48, 49, 54);
    border-top-color: rgb(48, 49, 54);
    border-bottom-color: rgb(48, 49, 54);
}

.uet-root .uet-tab {
    color: rgb(151, 153, 161);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.uet-root .uet-tab:hover {
    color: rgb(226, 227, 232);
    background-color: rgb(29, 30, 34);
}

.uet-root .uet-tab--active {
    color: rgb(126, 190, 255);
    background-color: rgb(25, 34, 47);
    border-bottom-color: rgb(96, 165, 250);
}

.uet-root .uet-switch {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.uet-root .uet-switch--on {
    color: rgb(225, 252, 235);
    background-color: rgb(38, 111, 70);
}

.uet-root .uet-switch--on:hover {
    background-color: rgb(48, 135, 86);
}

.uet-root .uet-switch--off {
    color: rgb(207, 209, 215);
    background-color: rgb(65, 67, 74);
}

.uet-root .uet-switch--off:hover {
    background-color: rgb(79, 81, 89);
}

.uet-root .uet-tool-expand {
    min-height: 28px;
    padding-left: 6px;
    color: rgb(224, 225, 230);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    -unity-text-align: middle-left;
}

.uet-root .uet-tool-expand__icon {
    width: 9px;
    min-width: 9px;
    height: 9px;
    min-height: 9px;
    margin-right: 10px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: rgb(173, 178, 184);
    border-bottom-color: rgb(173, 178, 184);
    rotate: -45deg;
}

.uet-root .uet-tool-expand--open .uet-tool-expand__icon {
    margin-top: -4px;
    rotate: 45deg;
}

.uet-root .uet-tool-expand:hover {
    color: rgb(126, 190, 255);
    background-color: rgb(30, 30, 34);
}

.uet-root .uet-text-field {
    min-height: 30px;
    margin-left: 0;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.uet-root .uet-text-field > .unity-base-field__input,
.uet-root .uet-text-field .unity-base-text-field__input,
.uet-root .uet-text-field .unity-text-input {
    min-height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: rgb(230, 231, 235);
    background-color: rgb(31, 32, 36);
    background-image: none;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(61, 62, 69);
    border-right-color: rgb(61, 62, 69);
    border-top-color: rgb(61, 62, 69);
    border-bottom-color: rgb(61, 62, 69);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-text-align: middle-left;
}

.uet-root .uet-text-field > .unity-base-field__label {
    display: none;
}

.uet-root .uet-text-field:hover > .unity-base-field__input,
.uet-root .uet-text-field:hover .unity-base-text-field__input,
.uet-root .uet-text-field:hover .unity-text-input {
    border-left-color: rgb(86, 87, 96);
    border-right-color: rgb(86, 87, 96);
    border-top-color: rgb(86, 87, 96);
    border-bottom-color: rgb(86, 87, 96);
}

.uet-root .uet-text-field--focus > .unity-base-field__input,
.uet-root .uet-text-field--focus .unity-base-text-field__input,
.uet-root .uet-text-field--focus .unity-text-input {
    border-left-color: rgb(96, 165, 250);
    border-right-color: rgb(96, 165, 250);
    border-top-color: rgb(96, 165, 250);
    border-bottom-color: rgb(96, 165, 250);
    background-color: rgb(35, 35, 39);
}

.uet-root .uet-text-field__placeholder {
    position: absolute;
    left: 11px;
    top: 7px;
    color: rgb(112, 114, 121);
    -unity-text-align: middle-left;
}

.uet-root .uet-notice {
    margin-bottom: 10px;
    padding-left: 13px;
    padding-right: 13px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgb(27, 34, 42);
    border-left-width: 3px;
    border-left-color: rgb(82, 171, 250);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.uet-root .uet-notice--warning {
    background-color: rgb(44, 31, 24);
    border-left-color: rgb(246, 185, 74);
}

.uet-root .uet-notice__title {
    margin-bottom: 3px;
    color: rgb(223, 225, 231);
    -unity-font-style: bold;
}

.uet-root .uet-notice__body {
    color: rgb(157, 160, 168);
    white-space: normal;
}

.uet-root .uet-tooltip {
    position: absolute;
    max-width: 312px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgb(42, 43, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(77, 78, 86);
    border-right-color: rgb(77, 78, 86);
    border-top-color: rgb(77, 78, 86);
    border-bottom-color: rgb(77, 78, 86);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.uet-root .uet-tooltip__text {
    color: rgb(226, 227, 231);
    font-size: 12px;
    white-space: normal;
}

.uet-root .uet-scroll > .unity-scroll-view__content-viewport {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.uet-root .uet-scroll .unity-scroller {
    width: 9px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.uet-root .uet-scroll .unity-scroller__low-button,
.uet-root .uet-scroll .unity-scroller__high-button {
    display: none;
    background-image: none;
}

.uet-root .uet-scroll .unity-scroller__slider,
.uet-root .uet-scroll .unity-base-slider {
    margin-left: 2px;
    margin-right: 2px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.uet-root .uet-scroll .unity-base-slider__tracker {
    background-color: rgb(25, 26, 29);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.uet-root .uet-scroll .unity-base-slider__dragger {
    width: 5px;
    background-color: rgb(79, 81, 89);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.uet-root .uet-scroll .unity-base-slider__dragger-border {
    width: 5px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.uet-root .uet-scroll .unity-base-slider__dragger:hover,
.uet-root .uet-scroll .unity-base-slider:active .unity-base-slider__dragger,
.uet-root .uet-scroll .unity-base-slider:focus .unity-base-slider__dragger {
    background-color: rgb(96, 165, 250);
}

.uet-root .uet-scroll .unity-base-slider:disabled .unity-base-slider__tracker {
    background-color: rgb(20, 21, 24);
}

.uet-root .uet-scroll .unity-base-slider:disabled .unity-base-slider__dragger {
    background-color: rgb(51, 52, 57);
}
